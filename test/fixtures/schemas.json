{
	"alibaba/z-image-turbo/text-to-image": {
		"model": "alibaba/z-image-turbo/text-to-image",
		"modality": "image",
		"taskTimeoutSeconds": 1800,
		"inputSchema": {
			"type": "object",
			"required": [
				"prompt"
			],
			"x-pricing": {
				"billingMode": "per_unit",
				"variantFields": [
					"enable_prompt_expansion"
				],
				"variantKeyOmitDefaults": [
					"enable_prompt_expansion"
				]
			},
			"properties": {
				"seed": {
					"type": "integer",
					"x-ui": {
						"order": 10,
						"widget": "number",
						"affects_price": false
					},
					"maximum": 2147483647,
					"minimum": 0,
					"description": "Random seed for controlled comparisons. Omit it to let each run pick its own."
				},
				"prompt": {
					"type": "string",
					"x-ui": {
						"rows": 4,
						"order": 100,
						"widget": "textarea",
						"primary": true
					},
					"maxLength": 1000,
					"minLength": 1,
					"description": "Describe the image to generate: subject, composition, style, and lighting."
				},
				"aspect_ratio": {
					"enum": [
						"1:1",
						"4:3",
						"3:4",
						"16:9",
						"9:16"
					],
					"type": "string",
					"x-ui": {
						"order": 80,
						"widget": "select"
					},
					"default": "1:1",
					"description": "Aspect ratio of the generated image."
				},
				"output_format": {
					"enum": [
						"png"
					],
					"type": "string",
					"x-ui": {
						"order": 30,
						"widget": "radio"
					},
					"default": "png",
					"description": "File format of the returned image."
				},
				"enable_prompt_expansion": {
					"type": "boolean",
					"x-ui": {
						"order": 50,
						"widget": "switch",
						"advanced": true,
						"affects_price": true
					},
					"default": false,
					"description": "Expand the prompt into a fuller description before generating. Requests with it on are billed at the prompt-expansion rate."
				}
			},
			"additionalProperties": false
		}
	},
	"bytedance/seedance-1.5-pro/image-to-video": {
		"model": "bytedance/seedance-1.5-pro/image-to-video",
		"modality": "video",
		"taskTimeoutSeconds": 10800,
		"inputSchema": {
			"additionalProperties": false,
			"properties": {
				"aspect_ratio": {
					"default": "16:9",
					"description": "Aspect ratio of the generated video.",
					"enum": [
						"21:9",
						"16:9",
						"4:3",
						"1:1",
						"3:4",
						"9:16"
					],
					"type": "string",
					"x-ui": {
						"affects_price": false,
						"order": 60,
						"widget": "select"
					}
				},
				"camera_fixed": {
					"default": false,
					"description": "Lock the camera to produce a stable, fixed-position shot.",
					"type": "boolean",
					"x-ui": {
						"affects_price": false,
						"order": 20,
						"widget": "switch"
					}
				},
				"duration_seconds": {
					"default": 5,
					"description": "Clip length in seconds. This is the billed quantity.",
					"maximum": 12,
					"minimum": 4,
					"type": "integer",
					"x-ui": {
						"advanced": false,
						"affects_price": true,
						"order": 40,
						"unit": "s",
						"widget": "slider"
					}
				},
				"generate_audio": {
					"default": true,
					"description": "Generate a native soundtrack synchronised to the picture.",
					"type": "boolean",
					"x-ui": {
						"advanced": false,
						"affects_price": true,
						"order": 30,
						"widget": "switch"
					}
				},
				"image_url": {
					"contentMediaType": [
						"image/jpeg",
						"image/png",
						"image/webp",
						"image/gif"
					],
					"description": "URL of the image used as the first frame.",
					"type": "string",
					"x-ui": {
						"affects_price": false,
						"order": 80,
						"widget": "upload"
					}
				},
				"last_image_url": {
					"contentMediaType": [
						"image/jpeg",
						"image/png",
						"image/webp",
						"image/gif"
					],
					"description": "Optional closing frame the shot has to land on (480p and 720p).",
					"type": "string",
					"x-ui": {
						"affects_price": false,
						"order": 75,
						"widget": "upload"
					}
				},
				"prompt": {
					"description": "What to generate: subject, action, camera movement and mood.",
					"minLength": 3,
					"type": "string",
					"x-ui": {
						"affects_price": false,
						"order": 90,
						"primary": true,
						"widget": "textarea"
					}
				},
				"resolution": {
					"default": "720p",
					"description": "Output resolution. Super-resolution tiers are not offered.",
					"enum": [
						"480p",
						"720p",
						"1080p"
					],
					"type": "string",
					"x-ui": {
						"advanced": false,
						"affects_price": true,
						"order": 50,
						"widget": "radio"
					}
				},
				"seed": {
					"description": "Random seed for controlled comparisons. Omit it to let each run pick its own.",
					"maximum": 2147483647,
					"minimum": 0,
					"type": "integer",
					"x-ui": {
						"affects_price": false,
						"order": 10,
						"widget": "number"
					}
				}
			},
			"required": [
				"prompt",
				"image_url"
			],
			"type": "object",
			"x-pricing": {
				"billingMode": "variant_matrix",
				"variantFields": [
					"resolution",
					"generate_audio"
				]
			}
		}
	},
